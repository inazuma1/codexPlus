HOST=127.0.0.1
PORT=3080
# 必填，聊天管理端和 Webhook 使用不同的随机令牌
ADMIN_TOKEN=replace-with-a-long-random-admin-token
WEBHOOK_TOKEN=replace-with-a-different-long-random-webhook-token
# 可选，自动创建目录并保存 store.json，无需数据库
DATA_DIR=./data
# Codex 可执行文件。Windows 可填写 codex.exe 的绝对路径
CODEX_BIN=codex
CODEX_WORKDIR=.
# read-only 或 workspace-write（允许工作目录内写入）
CODEX_SANDBOX=read-only
# 留空则继承 Codex config.toml，可配置 DeepSeek provider
CODEX_MODEL=
CODEX_TIMEOUT_MS=180000
# 执行中提问的等待时限（默认30分钟），等待期间不计执行超时
CODEX_INPUT_TIMEOUT_MS=1800000
# 同时运行任务数；同一会话仍按顺序执行
CODEX_CONCURRENCY=2
WEBHOOK_BATCH_MS=5000
# 用于无模型联调，生产环境设为 false
MOCK_CODEX=false
